# Vespasian environment
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials or session state.

# ── API plane (official Wix REST APIs — the primary channel) ──────────────
# Account-level API key from https://manage.wix.com/account/api-keys
# Sent as `Authorization: <key>` on every REST call.
WIX_API_KEY=

# Your Wix account GUID (shown next to the API key). Required for
# account-level calls (site create/list).
WIX_ACCOUNT_ID=

# Default target site GUID. Written automatically by
# `vespasian site create` / `vespasian site use` — leave empty until then.
WIX_SITE_ID=

# Cached metaSiteId for dashboard/editor URLs (optional).
WIX_METASITE_ID=

# ── Editor plane (consent-gated Playwright automation — the fallback) ─────
# Off until you run `vespasian login --editor` and acknowledge the consent
# prompt. Persisted browser session path (gitignored).
WIX_EDITOR_STORAGE_STATE=.vespasian/session/state.json

# 'false' (headed) is the default and the conservative choice — you can watch
# every editor action. Set 'true' only if you know what you are doing.
WIX_EDITOR_HEADLESS=false

# Reserved for future TOTP re-auth — NOT implemented in v0.1: session expiry
# always pauses for a human login (by design). Leave empty.
WIX_EDITOR_TOTP_SECRET=

# Human-plausible pacing for editor flows, in milliseconds.
WIX_EDITOR_SLOWMO_MS=150

# ── QA / visual verification ───────────────────────────────────────────────
# Published-site URL used by the visual-QA, responsive, cross-browser, and
# Lighthouse scripts (it is not derivable from WIX_SITE_ID without an API
# call). Also set as the WIX_SITE_URL repository variable in CI.
WIX_SITE_URL=

# ── Dry-run ────────────────────────────────────────────────────────────────
# Set to 1 to turn BOTH planes into recording transports: no credentials,
# no network, no browser. What CI uses. Leave empty for live runs.
VESPASIAN_DRY_RUN=
