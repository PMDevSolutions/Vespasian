# Claude Code Settings
# Ignore user-specific settings but preserve shared documentation
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/commands/
!.claude/hooks/
!.claude/validation/
!.claude/config/
!.claude/templates/
!.claude/*.md
!.claude/settings.json

# Deployment configs: example templates are tracked; real env files are not.
.claude/config/deployment/*.yml
.claude/config/deployment/*.yaml
!.claude/config/deployment/*.example.yml
!.claude/config/deployment/*.example.yaml
!.claude/config/deployment/README.md

# Claude Code temporary/user-specific files (explicitly ignored)
.claude/logs/
.claude/settings.local.json

# Visual QA screenshots (generated by visual-qa-agent)
.claude/visual-qa/

# Security reports (contain vulnerability details — do not commit)
.claude/security-reports/

# Credentials & environment — MUST never be committed.
# .env holds the Wix API key and account IDs; only the placeholder template is tracked.
.env
.env.*
!.env.example

# Vespasian state directory — editor session tokens (.vespasian/session/state.json),
# build plans, executor checkpoints, and dry-run logs. Session state is a live
# Wix login; treat it like a password. Never committed.
.vespasian/

# Extra credential guards
*.pem
*.key
*.cert

# Dependency directories
node_modules/

# Build & compiled files
/dist/
/build/
*.map

# Vespasian GUI (Electron) build output
# The root /dist/ and /build/ patterns above are root-anchored and do NOT match
# nested package output, so the GUI's build dirs are listed explicitly.
packages/gui/out/
packages/gui/dist/

# Package manager files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log
package-lock.json
yarn.lock
# pnpm-lock.yaml is tracked — required for reproducible CI installs.

# Visual regression scratch (baselines/ is tracked; actual/, diffs/, report are not)
tests/visual/actual/
tests/visual/diffs/
tests/visual/report.json

# Lighthouse CI scratch — local report output
.lighthouseci/

# Playwright (QA screenshots and editor automation)
.playwright/
playwright-report/

# Temporary files
*.tmp
*.bak
*.log
.cache/
.temp/
*.pid
*.seed
*.pid.lock
scratch/
notes/
sandbox/
experiments/

# Test scratch
coverage/
.coverage

# IDE & editor files
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace
.project
.settings/
*.code-workspace

# OS generated files
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Taskmaster files (if using ai-taskmaster)
.taskmaster/tasks/*.json.bak
.taskmaster/logs/

# Comments
# This .gitignore is designed so credentials cannot be committed by default:
# .env / .env.* (except .env.example) and the whole .vespasian/ state directory
# (editor session, checkpoints, dry-run logs) are always ignored.
# It excludes Claude Code user settings but preserves shared documentation and validation scripts.
