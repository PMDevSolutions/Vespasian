{
  "name": "@vespasian/gui",
  "version": "0.2.1",
  "private": true,
  "description": "Desktop GUI for Vespasian — a thin orchestration shell over the init wizard, the Wix site lifecycle (connect, apply, publish), the design-to-Wix pipelines, and visual QA. Invokes the existing scripts/pipelines; does not reimplement them.",
  "license": "MIT",
  "author": "PMDevSolutions",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"tests/**/*.test.mts\"",
    "smoke": "node tests/smoke/smoke.mjs",
    "package": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "1.61.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.4.3"
  }
}
