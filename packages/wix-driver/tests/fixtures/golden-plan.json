		{
			"id": "code-global-css",
			"op": "cli.writeGlobalCss",
			"method": "cli",
			"phase": "code",
			"input": {
				"css": "/*\n * global.css — generated by @vespasian/wix-driver. DO NOT HAND-EDIT.\n * Wix Studio custom CSS (src/styles/global.css via Git integration).\n * Theme panels remain the source of truth for colors/text slots; this file\n * carries the spacing scale, overflow type styles, and token variables.\n */\n\n/* Design-token color variables (reinforcement; panels set the real theme). */\n:root {\n\t--vsp-color-ink: #1A1A2E;\n\t--vsp-color-paper: #FAF8F5;\n\t--vsp-color-coral: #FF6B6B;\n\t--vsp-color-sage: #8FA998;\n\t--vsp-color-slate: #5C6B73;\n}\n\n/* Spacing scale — Wix has no spacing tokens; this is their only home. */\n:root {\n\t--vsp-space-10: 0.5rem;\n\t--vsp-space-20: 1rem;\n\t--vsp-space-40: 2rem;\n\t--vsp-space-80: 4rem;\n}\n\n.vsp-p-10 { padding: var(--vsp-space-10); }\n.vsp-m-10 { margin: var(--vsp-space-10); }\n.vsp-p-20 { padding: var(--vsp-space-20); }\n.vsp-m-20 { margin: var(--vsp-space-20); }\n.vsp-p-40 { padding: var(--vsp-space-40); }\n.vsp-m-40 { margin: var(--vsp-space-40); }\n.vsp-p-80 { padding: var(--vsp-space-80); }\n.vsp-m-80 { margin: var(--vsp-space-80); }\n"
			},
			"idempotencyKey": "fa68838418640354",
			"onFail": "retry"
		},
